# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Books API（ISBN検索・書籍検索に使用）
# https://console.cloud.google.com/ で Books API を有効化してキーを取得
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# 楽天ブックス API（日本の書籍検索フォールバック）
# https://webservice.rakuten.co.jp/ でアプリIDを取得
EXPO_PUBLIC_RAKUTEN_APP_ID=your-rakuten-app-id
EXPO_PUBLIC_RAKUTEN_ACCESS_KEY=your-rakuten-access-key
